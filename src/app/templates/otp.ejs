<!DOCTYPE html>
<html lang="en">

<head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Your OTP Code</title>
</head>

<body style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
      ">

      <div style="
      width: 100%;
      padding: 40px 0;
      ">

            <div style="
            max-width: 480px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px 32px;
            box-sizing: border-box;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            ">

                  <!-- Logo / Brand -->
                  <div style="
                  text-align: center;
                  margin-bottom: 30px;
                  ">
                        <h1 style="
                        margin: 0;
                        font-size: 28px;
                        color: #2563eb;
                        ">
                              PH Healthcare
                        </h1>
                  </div>

                  <!-- Greeting -->
                  <h2 style="
                  margin: 0 0 12px;
                  font-size: 24px;
                  color: #111827;
                  ">
                        Hello <%= name %> 👋
                  </h2>

                  <p style="
                  margin: 0 0 24px;
                  font-size: 15px;
                  line-height: 1.6;
                  color: #6b7280;
                  ">
                        We received a request to verify your account. Use the
                        verification code below to continue.
                  </p>

                  <!-- OTP Box -->
                  <div style="
                  background-color: #eff6ff;
                  border: 1px solid #bfdbfe;
                  border-radius: 10px;
                  padding: 20px;
                  text-align: center;
                  margin: 25px 0;
                  ">

                        <p style="
                        margin: 0 0 8px;
                        font-size: 13px;
                        color: #6b7280;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        ">
                              Your OTP Code
                        </p>

                        <div style="
                        font-size: 36px;
                        font-weight: bold;
                        letter-spacing: 8px;
                        color: #2563eb;
                        ">
                              <%= otp %>
                        </div>

                  </div>

                  <!-- Expiration -->
                  <p style="
                  margin: 0 0 20px;
                  text-align: center;
                  font-size: 14px;
                  color: #ef4444;
                  ">
                        ⏱ This code will expire in <strong>2 minutes</strong>.
                  </p>

                  <p style="
                  margin: 0;
                  font-size: 14px;
                  line-height: 1.6;
                  color: #6b7280;
                  ">
                        If you didn't request this code, you can safely ignore this
                        email. Never share your OTP with anyone.
                  </p>

                  <!-- Divider -->
                  <div style="
                  height: 1px;
                  background-color: #e5e7eb;
                  margin: 30px 0 20px;
                  "></div>

                  <!-- Footer -->
                  <p style="
                  margin: 0;
                  text-align: center;
                  font-size: 12px;
                  color: #9ca3af;
                  ">
                        © <%= new Date().getFullYear() %> PH Healthcare. All rights reserved.
                  </p>
            </div>
      </div>
</body>

</html>